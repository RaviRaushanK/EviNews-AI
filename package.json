{
  "name": "evinews-ai",
  "version": "1.0.0",
  "description": "An Evidence-Grounded Multi-Source News Analysis and Verification System",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "collect:newsapi": "node scripts/collect-newsapi.js",
    "collect:rss": "node scripts/collect-rss.js",
    "process:articles": "node scripts/process-articles.js",
    "cluster:articles": "node scripts/cluster-articles.js",
    "claims:extract": "node scripts/extract-claims.js",
    "claims:verify": "node scripts/verify-claims.js",
    "claims:test": "node scripts/test-claim-validation.js",
    "contradictions:test": "node scripts/test-contradiction-validation.js",
    "contradictions:candidates:test": "node scripts/test-contradiction-candidates.js",
    "contradictions:detection:test": "node scripts/test-contradiction-detection.js",
    "contradictions:query:test": "node scripts/test-contradiction-query.js",
    "contradictions:controller:test": "node scripts/test-contradiction-controller.js",
    "contradictions:evaluate": "node scripts/evaluate-contradictions.js"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "axios": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "mysql2": "^3.1.3",
    "nodemon": "^3.1.7",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
