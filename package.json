    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "mysql2": "^3.1.3",
    "nodemon": "^3.1.7",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
