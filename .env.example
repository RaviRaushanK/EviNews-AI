# EviNews-AI - Environment Variables

# Database Configuration
NODE_ENV=development
# DB_* selects the local development database; test uses DB_NAME with a _test suffix.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=evinews_ai

# Production requires all PROD_DB_* values before startup or migrations.
# Leave these unset for local development. Never reuse the development target.
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

# API Keys
NEWS_API_KEY=
GEMINI_API_KEY=

# NewsAPI collection settings
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_PAGE_SIZE=20
NEWS_API_COUNTRY=us
NEWS_API_LANGUAGE=en

# RSS collection settings (comma-separated feed URLs)
RSS_FEED_URLS=

# Collection behavior
COLLECTION_TIMEOUT_MS=10000
COLLECTION_USER_AGENT=EviNews-AI/1.0

# Gemini embedding settings (Phase 3)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_MAX_CHARS=7000
EMBEDDING_BATCH_SIZE=10
EMBEDDING_RETRY_DELAY_MS=2000

# Clustering settings (Phase 3)
ARTICLE_SIMILARITY_THRESHOLD=0.78
EVENT_MATCH_THRESHOLD=0.78
MIN_CLUSTER_SIZE=2
MAX_ARTICLES_PER_RUN=50

# Claim extraction settings (Phase 4)
# NOTE: GEMINI_CLAIM_MODEL must be set to a real Gemini text-generation model
# for live extraction. No model name is guessed or hardcoded by the code.
GEMINI_CLAIM_MODEL=
CLAIM_MAX_ARTICLE_CHARS=6000
CLAIM_MAX_PER_ARTICLE=10
CLAIM_TIMEOUT_MS=20000
CLAIM_RETRY_DELAY_MS=2000
CLAIM_MAX_ARTICLES_PER_RUN=20
EVIDENCE_MIN_OVERLAP=0.25

# Summary settings (Phase 7; explicit model required for later live generation)
GEMINI_SUMMARY_MODEL=
SUMMARY_PROMPT_VERSION=phase7-v2
SUMMARY_CONTRACT_VERSION=phase7-summary-v2
SUMMARY_MAX_CONTEXT_BYTES=64000
SUMMARY_MAX_CLAIMS=50
SUMMARY_MAX_EVIDENCE=100
SUMMARY_MAX_CONTRADICTIONS=100
SUMMARY_TIMEOUT_MS=20000

# Server Settings
PORT=3000
LOG_LEVEL=info

