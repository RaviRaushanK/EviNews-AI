<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EviNews-AI</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
  <header class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">EviNews-AI</a>
      <span class="navbar-text d-none d-sm-inline">Evidence-Grounded News Verification</span>
    </div>
  </header>

  <main class="container my-5 flex-grow-1">
    <section class="p-5 mb-4 rounded-3 border bg-body-tertiary">
      <div class="container py-3">
        <h1 class="display-5 fw-bold">Evidence-Grounded Multi-Source News Analysis</h1>
        <p class="lead">
          Collect, compare, and verify news from multiple sources to understand how information changes over time.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-primary btn-lg" href="/events">Browse Events</a>
          <button class="btn btn-primary btn-lg" type="button" id="searchNewsButton">Search News</button>
        </div>
        <p class="text-muted mt-3">
          Placeholder interface for the news search flow. Full collection and verification features will be added in later phases.
        </p>
      </div>
    </section>
  </main>

  <footer class="border-top bg-body-tertiary">
    <div class="container py-3">
      <p class="mb-0 text-muted">EviNews-AI · Phase 0 foundation</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
